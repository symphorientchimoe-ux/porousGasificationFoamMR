FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant/solidZone";
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Garnissage refractaire 50 mm du reacteur de Kim 2016 (sect. 2.2 : "had a
// refractory lining (thickness 50 mm)"). Nature, masse volumique, Cp et
// conductivite du refractaire : NON DONNES -> placeholders (meme modele
// heSolidThermo/constIso que test99 ; test99 = geopolymere 955 / 900 / 0.53).
// NB : l'inertie thermique du refractaire compte sur 2-4 h d'essai
// (diffusivite ~5e-7 m2/s -> penetration ~ sqrt(a t) ~ 6 cm en 2 h).

thermoType
{
    type            heSolidThermo;
    mixture         pureMixture;
    transport       constIso;
    thermo          eConst;
    equationOfState rhoConst;
    specie          specie;
    energy          sensibleInternalEnergy;
}

mixture
{
    specie
    {
        molWeight       100;
    }
    equationOfState
    {
        // 2026-09-29 : HYPOTHESE declaree (nature du garnissage non donnee par Kim) :
        //   brique refractaire dense silico-alumineuse, "Fireclay, burnt 1600 K",
        //   Incropera et al., Fundamentals of Heat and Mass Transfer, 7e ed.,
        //   Table A.3 (lue) : rho 2050, cp 960, k 1.0 (773 K) / 1.1 (1073 K).
        //   Plage a tester : k 0.1-1.5 (fibre / beton isolant / beton dense),
        //   experiment_setup.md sect. 1.
        rho             600;   // [kg/m3] brique isolante, valeur typique, HYPOTHESE (article ECM, 09/11/2026)
    }
    thermodynamics
    {
        Hf              0;
        Cv              1000;   // [J/kg/K] brique isolante, valeur typique, HYPOTHESE (article ECM)
    }
    transport
    {
        kappa           0.15;   // [W/m/K] brique isolante, valeur typique, HYPOTHESE (article ECM)
    }
}

