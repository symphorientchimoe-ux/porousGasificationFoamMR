FoamFile
{
    version     2.1;
    format      ascii;
    class       dictionary;
    object      solidThermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Kim 2016, granules de bois. Meme structure que test99 (5 composants).
// Les proprietes du solide (k, Cp, masse volumique INTRINSEQUE de chaque
// composant) ne sont PAS dans Kim 2016 -> placeholders. Rappel test78 : la
// masse du lit = somme(rho_i Y_i)(1-eps) doit redonner la masse chargee ;
// Kim 2016 sect. 2.2 : 15-17 kg pour 300 mm de lit (Ø 300 mm) -- valeur
// donnee sans distinction sludge/bois, a recouper dans data/.
// Hf de la cendre (-12.38e6 dans test99) : heritage du tutoriel, sans effet
// (cendre inerte) -- conserve.

thermoType solidMixtureThermo<constHeterogeneous>;

solidComponents
(
  moisture fuel char ash refractory
);

moistureCoeffs
{
    // eau liquide : proprietes generiques (identiques test99)
    transport      { K 0.6; }
    thermodynamics { Cp 4186; Hf 0; }
    density        { rho 1000; }
};

fuelCoeffs
{
    transport      { K   [[FROM data/model_properties_woodpellet.md]]; }   // cle : k bois [W/m/K]
    thermodynamics { Cp  [[FROM data/model_properties_woodpellet.md]]; Hf 0; }   // cle : Cp bois [J/kg/K]
    density        { rho [[FROM data/model_properties_woodpellet.md]]; }   // cle : rho bois (granule) [kg/m3]
};

charCoeffs
{
    transport      { K   [[FROM data/model_properties_woodpellet.md]]; }   // cle : k char [W/m/K]  (test99 : 0.15, Hankalin 2009)
    thermodynamics { Cp  [[FROM data/model_properties_woodpellet.md]]; Hf 0; }   // cle : Cp char [J/kg/K] (test99 : 1650, Gronli 1996)
    density        { rho [[FROM data/model_properties_woodpellet.md]]; }   // cle : rho char [kg/m3]
};

ashCoeffs
{
    transport      { K   [[FROM data/model_properties_woodpellet.md]]; }   // cle : k cendre [W/m/K]
    thermodynamics { Cp  [[FROM data/model_properties_woodpellet.md]]; Hf -12.38e6; }   // cle : Cp cendre [J/kg/K]
    density        { rho [[FROM data/model_properties_woodpellet.md]]; }   // cle : rho cendre [kg/m3] -- DOIT etre = ashDensity (pyrolysisProperties)
};

refractoryCoeffs
{
    // Composant INUTILISE dans fluidZone (Yrefractory = 0 partout ; le
    // garnissage est la region solidZone). Valeurs test99 conservees pour
    // que le melange reste bien defini.
    transport      { K 0.001; }
    thermodynamics { Cp 900; Hf 0; }
    density        { rho 955; }
};

