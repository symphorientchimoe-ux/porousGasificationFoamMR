FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system/fluidZone";
    object      topoSetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Execute APRES splitMeshRegions (topoSet -region fluidZone), comme test99.

actions
(
    // Allumage au kerosene au sommet du lit (Kim 2016, sect. 2.2 : "The fuel
    // particles were ignited at the top of the bed by kerosene" -- AUCUNE
    // autre information : ni quantite de kerosene, ni duree, ni surface).
    // Modelise comme dans test99 par l'allumeur maintenu de volPyrolysis
    // (Ts force a igniterTemperature pendant igniterDuration, voir
    // constant/fluidZone/pyrolysisProperties) sur toute la section du lit
    // (le kerosene est repandu sur la surface) et sur les 16 mm superieurs
    // du lit (z 0.384-0.400) : 3 cellules a 5 mm, 2 a 7 mm, 2 a 10 mm.
    // Epaisseur = CHOIX NUMERIQUE (test99 : 15 mm), pas une donnee de Kim.
    {
        name    igniterZone;
        type    cellSet;
        action  new;
        source  boxToCell;
        sourceInfo { box (-0.001 -0.02 0.390) (0.151 0.02 0.400); }   // 2026-10-06 ignThin : 1 rangee (10 mm) au lieu de 2 (kerosene brule en SURFACE, Kim sect. 2.2)
    }

    // Sous-zones materiau en cellSet (zoneStats / post-traitement), bornes
    // identiques a tools/make_blockMeshDict.py. Les cellZones plenum,
    // biomass_bed, gas_zone sont conservees par splitMeshRegions.
    { name plenum;      type cellSet; action new; source boxToCell; sourceInfo { box (-0.001 -0.02 -0.001) (0.151 0.02 0.100); } }
    { name biomass_bed; type cellSet; action new; source boxToCell; sourceInfo { box (-0.001 -0.02 0.100)  (0.151 0.02 0.400); } }
    { name gas_zone;    type cellSet; action new; source boxToCell; sourceInfo { box (-0.001 -0.02 0.400)  (0.151 0.02 0.701); } }
);

