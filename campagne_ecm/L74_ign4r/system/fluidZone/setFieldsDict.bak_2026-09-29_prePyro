FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system/fluidZone";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Etat initial du lit de granules de bois, Kim et al. 2016.
// Demarrage a froid T = Ts = 300 K partout (comme test93/99) ; l'allumage au
// kerosene est represente par l'allumeur maintenu (igniterZone,
// pyrolysisProperties), PAS par une boite chaude en condition initiale.
//
// Composition du solide (fractions massiques, base "tel que recu") :
// Kim 2016, Table 1, colonne "Wood pellet", analyse immediate :
//   humidite 7.99 %, matieres volatiles 78.37 %, carbone fixe 13.47 %,
//   cendre 0.17 %  (somme = 100.00 %).
// Correspondance modele (convention test18/test99) : Ymoisture = humidite,
// Yfuel = matieres volatiles, Ychar = carbone fixe, Yash = cendre.
// -> A CONFIRMER contre data/model_properties_woodpellet.md (si l'agent
//    "proprietes" retient une autre base ou une autre repartition, c'est
//    lui qui fait foi).
//
// Porosite du lit : NON donnee par Kim 2016 (seule la masse 15-17 kg pour
// 300 mm est donnee, sect. 2.2, sans distinguer les deux combustibles).

bedPorosity     [[FROM data/model_properties_woodpellet.md]];   // cle : porosite du lit eps0 [-]

defaultFieldValues
(
    volScalarFieldValue Ts          300
    volScalarFieldValue porosityF   1
    volScalarFieldValue porosityF0  1
    volScalarFieldValue Ymoisture   0
    volScalarFieldValue Yfuel       0
    volScalarFieldValue Ychar       0
    volScalarFieldValue Yash        0
);

regions
(
    zoneToCell
    {
        name    biomass_bed;
        fieldValues
        (
            volScalarFieldValue porosityF   $bedPorosity
            volScalarFieldValue porosityF0  $bedPorosity
            volScalarFieldValue Ymoisture   0.0799    // Kim 2016 Table 1
            volScalarFieldValue Yfuel       0.7837    // Kim 2016 Table 1 (MV)
            volScalarFieldValue Ychar       0.1347    // Kim 2016 Table 1 (CF)
            volScalarFieldValue Yash        0.0017    // Kim 2016 Table 1
        );
    }
);

