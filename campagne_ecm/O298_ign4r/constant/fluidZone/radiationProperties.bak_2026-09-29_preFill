FoamFile
{
    version     2.1;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      radiationProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Identique a test99 (heterogeneousP1 + CL MarshakRadiation a l'interface
// lit/refractaire) sauf 'as', qui depend du lit de granules.
// NB : le mot-cle "radiation off" est ignore par le solveur (le modele est
// choisi par heterogeneousRadiationModel) -- conserve comme dans test99.

radiation       off;  // laisse tel quel -- confirme sans effet (test99)

heterogeneousRadiationModel  heterogeneousP1;

solverFreq 1;

heterogeneousAbsorptionEmissionModel heterogeneousConstantAbsorptionEmission;

heterogeneousConstantAbsorptionEmissionCoeffs
{
    // absorption gaz non lumineux (valeur de depart test99, non calibree)
    a               a  [ 0 -1  0 0 0 0 0 ] 0.1;
    // absorption du lit : as ~ (1-eps)/dp (test99 : (1-0.481)/0.049 = 10.6)
    as              as [ 0 -1  0 0 0 0 0 ] [[FROM data/model_properties_woodpellet.md]];   // cle : as = (1-eps)/dp [1/m]
    // CL de Marshak cote solide : borderAs = chi/borderL, chi = e/(2(2-e)),
    // e = 0.85 emissivite du charbon (0.8-0.95, Vanaparti 2016 ; test85)
    // -> 246 1/m. Emissivite du char de bois du meme ordre : conserve,
    // a confirmer dans data/ si une valeur specifique est retenue.
    borderAs        borderAs [ 0 -1  0 0 0 0 0 ] 246;
    E               E  [ 1 -1 -3 0 0 0 0 ] 0.0;
    borderL         borderL  [ 0 1 0 0 0 0 0 ] 1.5e-3;
}

nRadCorrectors  1;

scatterModel    constant;

sigma           sigma [ 0 -1 0 0 0 0 0 ] 1;

C               C [ 0 0 0 0 0 0 0 ] 1;

// ************************************************************************* //
