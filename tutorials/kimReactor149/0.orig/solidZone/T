FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/solidZone";
    object      T;
}

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 300;

boundaryField
{
    outerWall
    {

        type            externalWallHeatFluxTemperature;
        mode            coefficient;

        Ta              constant 298;
        h               uniform 4.7;
        emissivity      0.30;
        thicknessLayers (0.003);
        kappaLayers     (10.8);
        value           uniform 300;
    }
    solidBottom
    {

        type            zeroGradient;
    }
    solidTop
    {
        type            zeroGradient;
    }
    solidZone_to_fluidZone
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;
        qr              none;
        qrNbr           qr;
        Tnbr            T;
        value           uniform 300;
    }
    front
    {
        type            wedge;
    }
    back
    {
        type            wedge;
    }
}

