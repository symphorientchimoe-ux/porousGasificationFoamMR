FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/fluidZone";
    object      G;
}

dimensions      [1 0 -3 0 0 0 0];

internalField   uniform 2000;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }
    outlet
    {
        type            zeroGradient;
    }
    fluidZone_to_solidZone
    {

        type            MarshakRadiation;
        T               T;
        emissivityMode  lookup;

        emissivity      uniform 0.67;
        value           uniform 100000;
    }
    front
    {
        type            wedge;
    }
    back
    {
        type            wedge;
    }
}

