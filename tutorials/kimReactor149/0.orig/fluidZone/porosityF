FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/fluidZone";
    object      porosityF;
}

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 1;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }
    outlet
    {
        type            zeroGradient;
    }
    fluidZone_to_solidZone
    {
        type            calculated;
        value           uniform 1;
    }
    front
    {
        type            wedge;
    }
    back
    {
        type            wedge;
    }
}

