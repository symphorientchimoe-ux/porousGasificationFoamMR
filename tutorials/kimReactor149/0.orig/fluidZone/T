FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/fluidZone";
    object      T;
}

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 300;

boundaryField
{
    inlet
    {

        type            fixedValue;
        value           uniform 300;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 300;
        value           uniform 300;
    }
    fluidZone_to_solidZone
    {

        type            compressible::turbulentTemperatureRadCoupledMixed;
        qr              qr;
        qrNbr           none;
        Tnbr            T;
        value           uniform 300;
    }
    front
    {
        type            wedge;
    }
    back
    {
        type            wedge;
    }
}

