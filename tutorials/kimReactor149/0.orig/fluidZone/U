FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0/fluidZone";
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inlet
    {

        type            flowRateInletVelocity;
        massFlowRate    constant 4.0633e-5;
        rho             rho;
        rhoInlet        1.176;
        value           uniform (0 0 0);
    }
    outlet
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }
    fluidZone_to_solidZone
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    front
    {
        type            wedge;
    }
    back
    {
        type            wedge;
    }
}

