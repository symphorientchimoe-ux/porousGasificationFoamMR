FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system/fluidZone";
    object      topoSetDict;
}

actions
(
    { name grate; type cellSet;     action new; source boxToCell;     sourceInfo { box (-0.001 -0.02 0.0875) (0.151 0.02 0.100); } }
    { name grate; type cellZoneSet; action new; source setToCellZone; sourceInfo { set grate; } }
);

