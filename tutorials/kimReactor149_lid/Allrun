#!/bin/sh
# Variant of ../kimReactor149 with the reactor closed by a lid with a central 40 mm outlet, as in the
# experiment of Kim et al. (2016). Version 1.1 inputs. The run starts from the state of the open-top case
# at 60 s, the end of its 800 K igniter stage (a cold start with the lid in place stopped within 0.04 s).
# From 60 s the igniter is held at 1000 K until 300 s. The version 1.0 run of this case is the "v1.0, lid"
# column of Table 7 of the paper; with version 1.1 it runs about three times slower than the open-top case.
cd "${0%/*}" || exit 1
. $WM_PROJECT_DIR/bin/tools/RunFunctions
runApplication decomposePar -allRegions -time 60
foamDictionary -entry pyrolysisCoeffs/igniterTemperature -set 1000 constant/fluidZone/pyrolysisProperties
foamDictionary -entry endTime -set 5000 system/controlDict
foamDictionary -entry maxUa -set 0.3 system/controlDict
runParallel porousGasificationFoamMR
