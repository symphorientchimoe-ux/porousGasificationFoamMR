FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant/solidZone";
    object      thermophysicalProperties;
}

thermoType
{
    type            heSolidThermo;
    mixture         pureMixture;
    transport       constIso;
    thermo          eConst;
    equationOfState rhoConst;
    specie          specie;
    energy          sensibleInternalEnergy;
}

mixture
{
    specie
    {
        molWeight       100;
    }
    equationOfState
    {

        rho             2050;
    }
    thermodynamics
    {
        Hf              0;
        Cv              960;
    }
    transport
    {
        kappa           1.0;
    }
}

