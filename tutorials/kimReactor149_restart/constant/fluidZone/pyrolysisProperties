FoamFile
{
    version         2.1;
    format          ascii;
    class           dictionary;
    location        "constant";
    object          pyrolysisProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

active          true;

heterogeneousPyrolysisModel volPyrolysis;

pyrolysisCoeffs
{
    bedCollapse     on;
    shrinkA         0.8;
    collapseInterval 0.5;
    bedZoneName     biomass_bed;
    subintegrateHeatTransfer false;
    igniterCellSet  igniterZone;
    igniterTemperature 1000;
    igniterDuration 300;
    ashDensity      2162;
}

infoOutput      true;


