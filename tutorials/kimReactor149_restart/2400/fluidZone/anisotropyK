FoamFile
{
    version     2.0;
    format      binary;
    class       volTensorField;
    location    "2400/fluidZone";
    object      anisotropyK;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform (1 0 0 0 1 0 0 0 1);

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform (1 0 0 0 1 0 0 0 1);
    }
    outlet
    {
        type            calculated;
        value           uniform (1 0 0 0 1 0 0 0 1);
    }
    back
    {
        type            wedge;
    }
    front
    {
        type            wedge;
    }
    fluidZone_to_solidZone
    {
        type            calculated;
        value           uniform (1 0 0 0 1 0 0 0 1);
    }
    lid
    {
        type            calculated;
        value           uniform (1 0 0 0 1 0 0 0 1);
    }
}


