// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Echange gaz-solide dans le lit (modele constCONV, comme test99).
// SAV = 6(1-eps)/dp_sv (surface specifique du lit) et h (correlation type
// Wakao & Kaguei a Re_p du granule 5 x 25 mm, Kim 2016 Table 1) : dependent
// de eps et du diametre equivalent -> placeholders.
heatTransferModel constCONV;

Parameters
{
    // 2026-09-29 -- h : Wakao & Kaguei, Nu = 2 + 1.1 Re^0.6 Pr^(1/3)
    //   (Wakao N., Kaguei S., Funazkri T. 1979, Chem. Eng. Sci. 34:325-336,
    //    doi:10.1016/0009-2509(79)85064-2 ; model_properties ligne 23).
    //   Conditions : G = 149 kg/m2/h = 0.04139 kg/m2/s ; air a 800 K
    //   (Incropera et al., Fundamentals of Heat and Mass Transfer, 7e ed.,
    //    Table A.4 : rho 0.4354 kg/m3, mu 369.8e-7 Pa.s, k 57.3e-3 W/m/K, Pr 0.709).
    //   U_superficielle(800 K) = G/rho = 0.0951 m/s (0.0356 m/s a 300 K).
    //   Re = G d_sv/mu = 0.04139*0.00682/3.698e-5 = 7.63 ; Re^0.6 = 3.385
    //   Nu = 2 + 1.1*3.385*0.709^(1/3) = 5.32
    //   h  = Nu k/d_sv = 5.32*0.0573/0.00682 = 44.7 W/m2/K
    //   NB : Re base sur le debit massique -> independant de rho ; h varie
    //   surtout via k(T) : ~37 a 600 K, ~50 a 1000 K. Candidat calage x0.5-2.
    // 2026-10-19 cas 298 (CONSTATS 21.48) : MEME correlation au debit de 298 kg/m2/h, G = 0.08278 kg/m2/s :
    //   Re = 15.27 ; Re^0.6 = 5.132 ; Nu = 2 + 1.1*5.132*0.709^(1/3) = 7.03 ; h = 7.03*0.0573/0.00682 = 59.1
    h    59.1;   // [W/m2/K] Wakao-Kaguei 1979 a 298 kg/m2/h (149 : 44.7)
    // SAV = 6(1-eps)/d_sv = 6*(1-0.38)/0.00682 = 545.5 1/m
    //   (DERIVE, model_properties ligne 6 : 546 ; eps 0.38 et d_sv 6.82 mm)
    SAV  545.5;  // [1/m] DERIVE
}

