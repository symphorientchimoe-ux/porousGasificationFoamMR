FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system/solidZone";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    // v4 (2026-09-09) : renomme T -> e (heSolidThermo/sensibleInternalEnergy,
    // cf createSolidFields.H/solveSolid.H -- T est desormais un champ
    // derive, pas resolu directement).
    e
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-10;
        relTol          0;
    }
}

relaxationFactors
{
    equations
    {
        e       1;
    }
}

