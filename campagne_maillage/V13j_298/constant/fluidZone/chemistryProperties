FoamFile
{
    version     2.1;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      chemistryProperties;
}

chemistry           on;

chemistryType
{
    solver            ode;
}

reactions
{
    COoxidation
    {

        type     irreversibleBoundedArrhenius;
        reaction "CO + 0.5O2^0.25 + H2O^0.5 = CO2 + H2O";
        A        2.239e12;
        beta     0;
        Ta       20470;
    }
    H2oxidation
    {

        type     irreversibleBoundedArrhenius;
        reaction "H2 + 0.5O2^1 = H2O";
        A        9.87e8;
        beta     0;
        Ta       3728.4;
    }
    CH4oxidation
    {

        type     irreversibleBoundedArrhenius;
        reaction "CH4^0.7 + 0.5O2^0.8 = CO + 2H2";
        A        5.012e11;
        beta     0;
        Ta       24054;
    }
    C2H4oxidation
    {
        // v1.2 (16/11/2026) HYPOTHESE : cinetique de CH4oxidation (Meng et al. 2018), aucune source
        // verifiee pour C2H4 ; a remplacer. C2H4 vient du regroupement des gaz CRECK (C2H6, aromatiques).
        type     irreversibleBoundedArrhenius;
        reaction "C2H4^0.7 + O2^0.8 = 2CO + 2H2";
        A        5.012e11;
        beta     0;
        Ta       24054;
    }
    TARoxidation
    {

        type     irreversibleBoundedArrhenius;
        reaction "C6H5OH^0.5 + 4O2^1 = 6CO + 3H2O";
        A        1.1185e8;
        beta     1;
        Ta       9621.7;
    }

}

solidChemistryType
{
    solver              solidOde;
    method              ODESolidHeterogeneousChemistryModel;
    solidThermoType     const<constRad<constThermo<constRho>>>;
}

chemistrySolver     ode;

solidChemistrySolver	solidOde;

initialChemicalTimeStep 1e-5;

gasChemistryTimeStepControl true;

gasAlphaTemp 0.1;

turbulentReaction   off;
solidReactionEnergyFromEnthalpy false;
stoichiometricReactions false;
showRelativeReactionRates false;

diffusionLimitedReactions true;

odeCoeffs
{
    solver          Rosenbrock34;
    absTol          1e-10;
    relTol          1e-6;
    maxSteps        100000;
}

solidOdeCoeffs
{

    solver      RKF45;
    absTol      1e-8;
    relTol      0.01;
    maxSteps    100000;
}

